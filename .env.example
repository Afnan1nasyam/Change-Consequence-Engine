# Change Consequence Engine - local configuration
#
# Copy to `.env`. Never commit `.env`.
#
#   cp .env.example .env
#
# The application starts and the full test suite passes with NO credentials set. Provider
# credentials are needed only to make real model calls.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
CCE_ENVIRONMENT=local
CCE_DEBUG=false
CCE_LOG_LEVEL=INFO
# json for machine-readable logs, console when reading them yourself
CCE_LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Persistence (matches docker-compose.yml)
# ---------------------------------------------------------------------------
# Placeholder only. The local docker-compose service creates the `cce` role; substitute the
# password it was started with. There is no default in code: an unset value raises
# `DatabaseNotConfigured` naming this variable rather than connecting somewhere plausible.
CCE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/cce
CCE_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# LLM gateway
# ---------------------------------------------------------------------------
# Groq is the default remote provider and the only one required.
CCE_LLM_DEFAULT_PROVIDER=groq

# Providers are enabled EXPLICITLY. A provider is never activated just because its key
# happens to be present - enabling one widens the data-egress surface (docs/SECURITY.md).
# Comma-separated. `fake` is the in-process test provider and costs nothing.
CCE_LLM_ENABLED_PROVIDERS=["groq","fake"]

# ---------------------------------------------------------------------------
# Model identifiers  (REQUIRED for real analysis)
# ---------------------------------------------------------------------------
# Deliberately blank. CCE ships no built-in model names: they are vendor inventory that
# changes, and a stale hard-coded identifier is an outage.
#
# Look up the identifiers your Groq account currently serves and paste them here. Check
# `GET /health/agents` afterwards - it reports which agents resolve, without spending a
# token.
#
#   reasoning -> judge, challenger, consequence hunter, blind-spot hunter
#   standard  -> specialist analysts, contradiction hunter, report composer
#   fast      -> assumption extraction (runs over the WHOLE corpus - keep this cheap),
#                change decomposition, classification, routing
CCE_MODEL_REASONING=
CCE_MODEL_STANDARD=
CCE_MODEL_FAST=

# ---------------------------------------------------------------------------
# Groq
# ---------------------------------------------------------------------------
CCE_GROQ_API_KEY=
CCE_GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Optional providers - leave blank unless you are using them
# ---------------------------------------------------------------------------
# Add the provider to CCE_LLM_ENABLED_PROVIDERS as well, or it stays inactive.
#
# Provider diversity is an open evaluation question (docs/EVALUATION.md, F1-F5): whether
# routing adversarial agents to a different model family reduces correlated reasoning
# error. Per-agent overrides live in app/config/agents.yaml.

# CCE_GEMINI_API_KEY=
# CCE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# CCE_MISTRAL_API_KEY=
# CCE_MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Local models. The only correct choice for a corpus that must not leave the network.
# CCE_OLLAMA_BASE_URL=http://localhost:11434

# Example per-agent model override, referenced from agents.yaml via `model_env`.
# CCE_MODEL_BLINDSPOT=

# ---------------------------------------------------------------------------
# Budgets and retries
# ---------------------------------------------------------------------------
CCE_LLM_MAX_OUTPUT_TOKENS=2048
# Ceiling for one analysis, enforced before dispatch rather than after the bill.
CCE_LLM_ANALYSIS_TOKEN_BUDGET=250000
CCE_LLM_TIMEOUT_S=60
CCE_LLM_MAX_ATTEMPTS=3
CCE_LLM_BACKOFF_BASE_S=0.5
CCE_LLM_BACKOFF_MAX_S=8

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Which strategy answers a request that does not name one: lexical | vector | hybrid.
# `lexical` is the default because it is the strongest measured strategy and needs no
# embedder. `vector` and `hybrid` are selectable and both currently measure worse
# (docs/EVALUATION.md); selecting either without an embedder configured is an error rather
# than a silent fall back to lexical.
CCE_RETRIEVAL_STRATEGY=lexical

# ---------------------------------------------------------------------------
# Embeddings (vector retrieval)
# ---------------------------------------------------------------------------
# The default adapter needs no credential and no network, so vector retrieval is
# developable and testable offline (ARCHITECTURE.md 11.4). It is feature hashing over a
# bag of words: it exercises the machinery and knows nothing semantic.
CCE_EMBEDDING_PROVIDER=hashing

# Enabled explicitly, exactly like LLM providers. A remote embedder sends corpus text -
# including spans from documents under an ACL - to a third party, so `http` is absent here
# by default and adding it is an operator's decision, not a consequence of setting a key.
CCE_EMBEDDING_ENABLED_PROVIDERS=["hashing","replay"]

# Required by the remote adapter, and each has no default on purpose.
#   model  - a vector index has to name the model that produced it
#   key    - from the environment only, never a literal
#   width  - validated per vector; nothing in a response proves which model answered
# CCE_MODEL_EMBEDDING=
# CCE_EMBEDDING_API_KEY=
# CCE_EMBEDDING_BASE_URL=
# CCE_EMBEDDING_DIMENSIONS=

# Set only for providers documented to return unit vectors. Checked when true, because a
# ranking measured under one normalization convention is not comparable with the other.
# CCE_EMBEDDING_EXPECTS_UNIT_VECTORS=false

# CCE_EMBEDDING_MAX_BATCH_SIZE=64
# CCE_EMBEDDING_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Gemini embeddings — the planned real-embedding experiment (docs/STATUS.md 36)
# ---------------------------------------------------------------------------
# PLACEHOLDERS ONLY. Nothing here is set, no live call has ever been made through the
# Gemini adapter, and no key belongs in this file — it is committed. Put the real value in
# `.env`, which is gitignored, or export it in the shell for the length of one run.
#
# Uncomment and fill these four, add `gemini` to the enabled list, and the recorder's
# preflight (`make embeddings-check`) will confirm it is ready:
#
# CCE_EMBEDDING_PROVIDER=gemini
# CCE_EMBEDDING_ENABLED_PROVIDERS=["hashing","replay","gemini"]
# CCE_MODEL_EMBEDDING=gemini-embedding-001
# CCE_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# CCE_EMBEDDING_DIMENSIONS=768
# CCE_EMBEDDING_API_KEY=<your key — never commit this>
#
# 768 is a documented Matryoshka width for gemini-embedding-001 (3072 native, 1536 and 768
# supported truncations). It is not a tuned choice: nothing has compared the three.
#
# Leave EXPECTS_UNIT_VECTORS false. Google documents sub-3072 output as unnormalized, and
# cosine is scale-invariant so the ranking is identical either way. If the first real run
# returns unit-length vectors, set it true and nothing else changes.
# CCE_EMBEDDING_EXPECTS_UNIT_VECTORS=false
#
# Gemini accepts a taskType. For retrieval Google recommends the asymmetric pair
# RETRIEVAL_DOCUMENT / RETRIEVAL_QUERY, which EmbeddingPort cannot express — it takes one
# undifferentiated list of texts. One symmetric value is what the current interface can
# honestly do, and it probably costs recall (docs/STATUS.md 44).
# CCE_EMBEDDING_TASK_TYPE=SEMANTIC_SIMILARITY
