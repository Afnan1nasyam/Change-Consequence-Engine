# Secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Local data - the corpus may contain sensitive material; only fixtures are tracked
data/sample_corpus/*
!data/sample_corpus/.gitkeep
data/benchmarks/*
!data/benchmarks/.gitkeep
!data/fixtures/

# Evaluation output
evaluation_runs/
*.duckdb

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
